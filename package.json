{
  "name": "openchamber-jobs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shell jobs for OpenChamber conversations and their subagents",
  "engines": { "node": ">=22.18.0" },
  "scripts": {
    "build": "node build.mjs",
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "package": "npm run build && node package.mjs"
  },
  "devDependencies": {
    "@openchamber/sdk": "^2.2.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  },
  "openchamber": {
    "apiVersion": 1,
    "engines": { "openchamber": ">=2.2.0" },
    "contributes": {
      "panel": { "id": "openchamber-jobs", "name": "Jobs", "icon": "service-bell", "entry": "panel/index.html" },
      "capabilities": ["shells", "sessions"]
    }
  }
}
